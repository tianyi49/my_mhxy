{
    "task": [
        {
            "name": "创建队伍",
            "entry": "chuangjianduiwu",
            "option": [
                "创建（副本/捉鬼）任务",
                "任务描述(用户输入)",
                "创建队伍-是否自动匹配"
            ],
            "description": "./docs/description/chuangjianduiwu.md"
        }
    ],
    "option": {
        "创建（副本/捉鬼）任务": {
            "type": "select",
            "cases": [
                {
                    "name": "创建520副本任务",
                    "description": "影响等级区间",
                    "pipeline_override": {
                        "队伍-点击日常任务": {
                            "next": [
                                "队伍-点击副本任务520"
                            ]
                        }
                    }
                },
                {
                    "name": "创建320副本任务",
                    "description": "影响等级区间",
                    "pipeline_override": {
                        "队伍-点击日常任务": {
                            "next": [
                                "队伍-点击副本任务320"
                            ]
                        }
                    }
                },
                {
                    "name": "创建捉鬼任务",
                    "pipeline_override": {
                        "队伍-点击日常任务": {
                            "next": [
                                "队伍-点击捉鬼任务"
                            ]
                        }
                    }
                },
                {
                    "name": "仅创建队伍",
                    "description": "只创建队伍；创建成功或已经在队伍中时立即结束，不设置任务目标、自动匹配或等待队员",
                    "pipeline_override": {
                        "队伍-点击创建队伍": {
                            "next": [
                                "队伍-仅创建完成"
                            ]
                        },
                        "队伍-已创建队伍": {
                            "next": [
                                "队伍-仅创建完成"
                            ]
                        }
                    }
                }
            ]
        },
        "任务描述(用户输入)": {
            "type": "input",
            "inputs": [
                {
                    "name": "任务描述",
                    "pipeline_type": "string",
                    "default": ""
                }
            ],
            "pipeline_override": {
                "队伍-任务描述-用户输入": {
                    "custom_action_param": {
                        "text": "{任务描述}",
                        "allow_empty": true,
                        "max_length": 10
                    }
                }
            }
        },
        "创建队伍-是否自动匹配": {
            "type": "switch",
            "cases": [
                {
                    "name": "开启自动匹配",
                    "pipeline_override": {}
                },
                {
                    "name": "不自动匹配",
                    "pipeline_override": {
                        "队伍-处理自动匹配选项": {
                            "next": [
                                "队伍-取消默认自动匹配"
                            ]
                        },
                        "队伍-目标已设置": {
                            "next": [
                                "队伍-人员已满",
                                "[JumpBack]队伍-点击一键喊话-当前"
                            ]
                        }
                    }
                }
            ]
        }
    }
}
